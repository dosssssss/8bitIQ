{
  "name": "8bitiq",
  "version": "0.1.0",
  "description": "Web-based puzzle game: timed runs of random mini-games with a Top 10 leaderboard.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "npm run build:games && node --watch backend/server.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "build:games": "tsc --noEmit false --outDir backend/.build --rootDir backend",
    "prestart": "npm run build:games"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
