# Copy this file to .env (never commit .env) and fill in the values.
# Supabase: Project Settings > API.

# "supabase" saves players and scores in Supabase. Leave empty to keep them
# in memory (lost when the server restarts), which is what the tests use.
DATA_STORE=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key. Server only: never put it in the app or in Git.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Defaults to 3000.
# PORT=3000
